APP_NAME="نبض سلامت"
APP_ENV=production
APP_KEY=                        # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://nabzsn.ir
APP_PORT=80                     # host HTTP port → origin (CDN terminates TLS)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nabzesalamat_db
DB_USERNAME=sail
DB_PASSWORD=                    # strong password
DB_ROOT_PASSWORD=               # strong root password (used by mysql container)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true      # HTTPS via CDN — avoid mixed cookie / content issues

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=

# Bale channel broadcast (blog publish notifications)
BALE_ENABLED=false
BALE_BOT_TOKEN=
BALE_CHANNEL_ID=@your_channel

# Telegram channel broadcast (Bot API — channels only)
# On Iranian VPS: install v2rayA on the HOST, import subscription URL, enable local
# HTTP inbound (default 20171). Do NOT enable system TUN. Then:
#   TELEGRAM_HTTP_PROXY=http://host.docker.internal:20171
# (or socks5h://host.docker.internal:20170). Firewall: block public access to those ports.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@NabzSalamatMedia
TELEGRAM_HTTP_PROXY=http://host.docker.internal:20171
